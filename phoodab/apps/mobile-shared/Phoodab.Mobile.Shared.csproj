<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <DetectedDotNetRoot Condition="'$(DetectedDotNetRoot)' == '' and '$(NetCoreRoot)' != ''">$(NetCoreRoot)</DetectedDotNetRoot>
    <DetectedDotNetRoot Condition="'$(DetectedDotNetRoot)' == '' and '$(DOTNET_ROOT)' != ''">$(DOTNET_ROOT)</DetectedDotNetRoot>
    <DetectedDotNetRoot Condition="'$(DetectedDotNetRoot)' == '' and '$(MSBuildSDKsPath)' != ''">$([System.IO.Path]::GetFullPath('$(MSBuildSDKsPath)/../../..'))</DetectedDotNetRoot>
    <MauiSdkPackPath Condition="'$(MauiSdkPackPath)' == '' and '$(DetectedDotNetRoot)' != ''">$([System.IO.Path]::Combine('$(DetectedDotNetRoot)', 'packs', 'Microsoft.Maui.Sdk'))</MauiSdkPackPath>
    <DetectedAndroidSdkDirectory Condition="'$(DetectedAndroidSdkDirectory)' == '' and '$(AndroidSdkDirectory)' != ''">$(AndroidSdkDirectory)</DetectedAndroidSdkDirectory>
    <DetectedAndroidSdkDirectory Condition="'$(DetectedAndroidSdkDirectory)' == '' and '$(ANDROID_SDK_ROOT)' != ''">$(ANDROID_SDK_ROOT)</DetectedAndroidSdkDirectory>
    <DetectedAndroidSdkDirectory Condition="'$(DetectedAndroidSdkDirectory)' == '' and '$(ANDROID_HOME)' != ''">$(ANDROID_HOME)</DetectedAndroidSdkDirectory>
    <CanTargetAndroid Condition="'$(CanTargetAndroid)' == '' and Exists('$(MauiSdkPackPath)') and Exists('$(DetectedAndroidSdkDirectory)')">true</CanTargetAndroid>
    <CanTargetAndroid Condition="'$(CanTargetAndroid)' == ''">false</CanTargetAndroid>
    <CanTargetWindows Condition="'$(CanTargetWindows)' == '' and Exists('$(MauiSdkPackPath)') and $([MSBuild]::IsOSPlatform('windows'))">true</CanTargetWindows>
    <CanTargetWindows Condition="'$(CanTargetWindows)' == ''">false</CanTargetWindows>
    <TargetFramework Condition="'$(CanTargetAndroid)' == 'true' and '$(CanTargetWindows)' != 'true'">net10.0-android</TargetFramework>
    <TargetFramework Condition="'$(CanTargetWindows)' == 'true' and '$(CanTargetAndroid)' != 'true'">net10.0-windows10.0.19041.0</TargetFramework>
    <TargetFrameworks Condition="'$(CanTargetAndroid)' == 'true' and '$(CanTargetWindows)' == 'true'">net10.0-android;net10.0-windows10.0.19041.0</TargetFrameworks>
    <TargetFramework Condition="'$(CanTargetAndroid)' != 'true' and '$(CanTargetWindows)' != 'true'">net10.0</TargetFramework>
    <RootNamespace>Phoodab.Mobile.Shared</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
    <ProjectReference Include="..\..\backend\src\Phoodab.Application\Phoodab.Application.csproj" />
    <ProjectReference Include="..\..\backend\src\Phoodab.Domain\Phoodab.Domain.csproj" />
  </ItemGroup>
</Project>
